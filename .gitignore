# Secrets — base and all variants (e.g. .env.local, .env.prod, .env.staging)
.env
.env.*

# Key and certificate files
*.pem
*.key
*.crt
*.p12
*.pfx
service-account*.json
*-credentials.json

# Python
__pycache__/
*.pyc
.venv/

# Local runtime data (SQLite observations)
data/

# Docker build context (secrets must never land in a layer)
.dockerignore.local
